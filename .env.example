# SafetyGraph Server Configuration
PORT=4000
NODE_ENV=development

# Neo4j Knowledge Graph Configuration
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# PostgreSQL / pgvector Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=safetygraph
DATABASE_URL=postgresql://postgres:password@localhost:5432/safetygraph

# LLM Provider Configuration
# Supported providers: "anthropic" | "mock"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Guardrail & Safety Limits
GUARDRAIL_MAX_INPUT=10000
GUARDRAIL_MAX_OUTPUT=50000
GUARDRAIL_MAX_CONTEXT_TOKENS=4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
