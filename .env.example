# SafetyGraph Server Configuration
PORT=4000
NODE_ENV=development

# Neo4j Knowledge Graph Configuration
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# PostgreSQL / pgvector Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=safetygraph
DATABASE_URL=postgresql://postgres:password@localhost:5432/safetygraph

# ==============================================================================
# LLM Provider Configuration (Provider-Agnostic)
# Supported providers: "anthropic" | "openai" | "ollama" | "groq" | "deepseek" | "openrouter" | "custom" | "mock"
# Note: If LLM_PROVIDER is omitted, SafetyGraph auto-detects based on available keys.
# ==============================================================================
LLM_PROVIDER=mock

# 1. Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. OpenAI (GPT-4o, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 3. Local Ollama (Free, runs locally, no key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=ollama

# 4. Groq Cloud (Ultra-fast LPU inference)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# 5. DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 6. OpenRouter (Unified multi-model gateway)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# 7. Custom OpenAI-compatible endpoint (vLLM, LM Studio, LocalAI)
CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
CUSTOM_LLM_API_KEY=custom
CUSTOM_LLM_MODEL=custom-model

# Guardrail & Safety Limits
GUARDRAIL_MAX_INPUT=10000
GUARDRAIL_MAX_OUTPUT=50000
GUARDRAIL_MAX_CONTEXT_TOKENS=4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
