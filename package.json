{
  "name": "safetygraph",
  "version": "1.0.0",
  "description": "SafetyGraph / VerifiedRAG - Model-Provider-Agnostic Headless Hybrid RAG Engine with Deterministic Guardrails",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "rag",
    "graphrag",
    "model-agnostic",
    "provider-agnostic",
    "guardrails",
    "neo4j",
    "pgvector",
    "anthropic",
    "openai",
    "ollama",
    "groq",
    "deepseek",
    "openrouter"
  ],
  "author": "Ashmit Kundu",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamnottheone99/safetygraph.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^17.3.1",
    "envalid": "^8.1.1",
    "fastify": "^5.12.5",
    "neo4j-driver": "^6.0.1",
    "openai": "^7.10.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "jest": "^30.3.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.1"
  }
